# Discord
TOKEN=YOUR_DISCORD_BOT_TOKEN
PREFIX=!!

# Database (optional; if omitted, JSON storage is used)
MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Slash Commands
# Comma-separated guild IDs for instant per-guild registration
GUILD_ID=
# Set to true to register globally (takes up to 1 hour to propagate)
SLASH_GLOBAL=false

# Web server port (optional; defaults to 3000)
PORT=3000
